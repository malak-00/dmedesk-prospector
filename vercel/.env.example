# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard
# (Project Settings -> Environment Variables) for a real deployment.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Service role key -- server-side only, NEVER expose to the browser or commit it.
# Used only for the small number of operations that must bypass Row-Level
# Security (looking up a session's own profile before RLS can apply).
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key -- safe for a browser, but used here server-side too,
# paired with each request's own user access token, so every data query
# still runs "as" that signed-in user and Postgres RLS policies apply.
SUPABASE_ANON_KEY=

# NPPES NPI Registry API version (public, no key needed)
NPPES_VERSION=2.1

# Optional -- Foursquare Places API (new, not legacy v3). Enrichment
# degrades gracefully (skipped, not an error) if unset.
FOURSQUARE_SERVICE_API_KEY=

# Optional -- Google AI Studio (Gemini). Call-brief generation is
# unavailable (returns a clear error, not a crash) if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origin(s) allowed to call this API with credentials -- set to your
# frontend's real origin(s) once deployed (comma-separated for more than
# one, e.g. your GitHub Pages URL during a parallel-run cutover plus your
# final domain). Never use "*" once real auth tokens are involved.
ALLOWED_ORIGINS=http://localhost:8080
