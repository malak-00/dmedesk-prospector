PORT=3000
NODE_ENV=development
NPPES_VERSION=2.1
FOURSQUARE_SERVICE_API_KEY=your_foursquare_service_api_key_here
# Second "Places"-style enrichment source, used only for companies Foursquare
# didn't cover -- get a key at serpapi.com (250 searches/month free)
SERPAPI_API_KEY=your_serpapi_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# Alternative to the path above, for hosts where you can only set env vars
# (not upload files) -- paste the key file's JSON contents or its base64 encoding
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB_NAME=Leads
# Protects the whole app (dashboard + API) with an HTTP Basic Auth prompt.
# Leave both unset for open/no-auth access (e.g. local dev).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=